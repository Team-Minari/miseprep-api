{
  "info": {
    "name": "miseprep-api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "카카오 로그인 (리다이렉트)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/oauth/kakao/authorize?redirect_uri=http://localhost:3000/callback",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "oauth", "kakao", "authorize"],
              "query": [{ "key": "redirect_uri", "value": "http://localhost:3000/callback" }]
            }
          }
        },
        {
          "name": "카카오 콜백",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/oauth/kakao/callback?code=KAKAO_CODE&redirect_uri=http://localhost:3000/callback",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "oauth", "kakao", "callback"],
              "query": [
                { "key": "code", "value": "KAKAO_CODE" },
                { "key": "redirect_uri", "value": "http://localhost:3000/callback" }
              ]
            }
          }
        },
        {
          "name": "액세스 토큰 재발급",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data) {",
                  "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            }
          }
        },
        {
          "name": "로그아웃",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Refresh-Token", "value": "{{refreshToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Member",
      "item": [
        {
          "name": "내 정보 조회",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/members/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "me"]
            }
          }
        },
        {
          "name": "내 정보 수정",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"홍길동\",\n  \"profile_image_url\": \"https://example.com/image.png\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/members/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "me"]
            }
          }
        },
        {
          "name": "회원 탈퇴",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/members/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Product",
      "item": [
        {
          "name": "[테스트용] 상품 생성",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"테스트 상품\",\n  \"description\": \"상품 설명\",\n  \"price\": 10000,\n  \"image_url\": \"https://example.com/product.png\",\n  \"category\": \"FOOD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "상품 목록 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?category=FOOD&keyword=테스트",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "category", "value": "FOOD", "description": "선택 사항" },
                { "key": "keyword", "value": "테스트", "description": "선택 사항" }
              ]
            }
          }
        },
        {
          "name": "상품 단건 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "장바구니 생성",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"우리 장바구니\",\n  \"category\": \"FOOD\",\n  \"purpose\": \"주간 장보기\",\n  \"is_public\": true,\n  \"budget\": 50000,\n  \"cart_type\": \"SHARED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/carts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carts"]
            }
          }
        },
        {
          "name": "자연어 장바구니 검색",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"주말 캠핑 준비물\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/carts/search",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carts", "search"]
            }
          }
        },
        {
          "name": "공개 장바구니 목록 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/carts?category=FOOD",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carts"],
              "query": [
                { "key": "category", "value": "FOOD", "description": "선택 사항" }
              ]
            }
          }
        },
        {
          "name": "내 장바구니 목록 조회",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/carts/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carts", "me"]
            }
          }
        },
        {
          "name": "장바구니 단건 조회",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/carts/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carts", "1"]
            }
          }
        },
        {
          "name": "장바구니 참여자 목록 조회",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/carts/1/participants",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carts", "1", "participants"]
            }
          }
        },
        {
          "name": "링크로 장바구니 참여",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/carts/join?token=LINK_TOKEN",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carts", "join"],
              "query": [{ "key": "token", "value": "LINK_TOKEN" }]
            }
          }
        },
        {
          "name": "장바구니 설정 수정 (소유자)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cartName\": \"새 이름\",\n  \"isPublic\": false,\n  \"category\": \"FOOD\",\n  \"purpose\": \"새 목적\",\n  \"budget\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/carts/1/settings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carts", "1", "settings"]
            }
          }
        },
        {
          "name": "소유권 이전 (소유자)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newOwnerId\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/carts/1/owner",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carts", "1", "owner"]
            }
          }
        },
        {
          "name": "장바구니 삭제 (소유자)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/carts/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carts", "1"]
            }
          }
        },
        {
          "name": "장바구니 나가기",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/carts/1/leave",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carts", "1", "leave"]
            }
          }
        },
        {
          "name": "참여자 강퇴 (소유자)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/carts/1/participants/2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carts", "1", "participants", "2"]
            }
          }
        },
        {
          "name": "Cart Items",
          "item": [
            {
              "name": "장바구니 상품 목록 조회",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
                "url": {
                  "raw": "{{baseUrl}}/api/carts/1/items",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "carts", "1", "items"]
                }
              }
            },
            {
              "name": "장바구니 상품 추가",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"product_id\": 1,\n  \"quantity\": 2\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/carts/1/items",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "carts", "1", "items"]
                }
              }
            },
            {
              "name": "장바구니 상품 수량 수정",
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"quantity\": 3\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/carts/1/items/1",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "carts", "1", "items", "1"]
                }
              }
            },
            {
              "name": "장바구니 상품 단건 삭제",
              "request": {
                "method": "DELETE",
                "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
                "url": {
                  "raw": "{{baseUrl}}/api/carts/1/items/1",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "carts", "1", "items", "1"]
                }
              }
            },
            {
              "name": "장바구니 상품 일괄 삭제",
              "request": {
                "method": "DELETE",
                "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
                "url": {
                  "raw": "{{baseUrl}}/api/carts/1/items",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "carts", "1", "items"]
                }
              }
            },
            {
              "name": "상품 체크",
              "request": {
                "method": "POST",
                "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
                "url": {
                  "raw": "{{baseUrl}}/api/carts/1/items/1/check",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "carts", "1", "items", "1", "check"]
                }
              }
            },
            {
              "name": "상품 체크 해제",
              "request": {
                "method": "DELETE",
                "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
                "url": {
                  "raw": "{{baseUrl}}/api/carts/1/items/1/check",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "carts", "1", "items", "1", "check"]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Invitation",
      "item": [
        {
          "name": "초대 보내기",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"invited@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/carts/1/invitations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carts", "1", "invitations"]
            }
          }
        },
        {
          "name": "내 초대 목록 조회",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/invitations/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invitations", "me"]
            }
          }
        },
        {
          "name": "초대 수락/거절",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACCEPTED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/invitations/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invitations", "1"]
            }
          }
        },
        {
          "name": "초대 취소",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/invitations/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invitations", "1"]
            }
          }
        }
      ]
    }
  ]
}
